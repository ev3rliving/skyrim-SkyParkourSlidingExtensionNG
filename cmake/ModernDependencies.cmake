set(SLIDE_DEPENDENCIES "${CMAKE_CURRENT_SOURCE_DIR}/dependencies/modern" CACHE PATH "Directory containing CommonLibSSE-modern and DirectXTK checkouts")
set(SLIDE_LEGACY_DEPS "${CMAKE_CURRENT_SOURCE_DIR}/dependencies/legacy" CACHE PATH "Directory containing spdlog and rapidcsv")
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_SE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_AE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_VR OFF CACHE BOOL "" FORCE)
set(SKSE_SUPPORT_PATCH_SAFETY OFF CACHE BOOL "" FORCE)
set(COMMONLIB_ENABLE_IPO OFF CACHE BOOL "" FORCE)
set(BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(BUILD_XAUDIO_WIN8 OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL ON CACHE BOOL "" FORCE)
include(FetchContent)
FetchContent_Declare(spdlog SOURCE_DIR "${SLIDE_LEGACY_DEPS}/spdlog" OVERRIDE_FIND_PACKAGE)
FetchContent_Declare(directxtk SOURCE_DIR "${SLIDE_DEPENDENCIES}/DirectXTK" OVERRIDE_FIND_PACKAGE)
FetchContent_MakeAvailable(spdlog directxtk)
if(NOT TARGET Microsoft::DirectXTK)
    add_library(Microsoft::DirectXTK ALIAS DirectXTK)
endif()
set(RAPIDCSV_INCLUDE_DIRS "${SLIDE_LEGACY_DEPS}/rapidcsv/src" CACHE PATH "" FORCE)
add_subdirectory("${SLIDE_DEPENDENCIES}/CommonLibSSE-modern" commonlib-modern)
